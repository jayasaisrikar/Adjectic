# Copy to .env.local and fill in what you have. Every value is optional:
# anything left blank is hidden on the page or falls back gracefully.
# Values are read at build time (see app/site.js).

# Google Apps Script web-app URL (…/exec) that stores audit requests in a Sheet.
# Without it, the audit form only appears in `npm run dev` (in a demo mode that stores nothing).
AUDIT_FORM_URL=

# External audit page, used only when AUDIT_FORM_URL is not set.
AUDIT_URL=

# "Book a strategy call" link in the hero.
CALENDAR_URL=

# Shown in the footer and in the form's error message.
CONTACT_EMAIL=

# Minimum monthly fee in USD, e.g. 1500. Used by the pricing calculator and FAQ.
MIN_FEE=

# Case-study outcome figures. The numbers show only when all four are set;
# otherwise the outcome is described in words.
CASE_ACOS_AFTER=
CASE_TACOS_BEFORE=
CASE_TACOS_AFTER=
CASE_SALES_CHANGE=
